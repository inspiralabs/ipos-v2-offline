# RAHASIA - jangan commit ke git!
VITE_SECURE_SALT_LITE=your-lite-salt-here
VITE_SECURE_SALT_PRO=your-pro-salt-here

# Dipakai saat build produksi. Saat `pnpm dev`, permintaan /api/clients
# di-proxy ke tenant-service lokal (localhost:3002) supaya toko yang baru
# daftar langsung muncul di admin lokal.
VITE_API_URL=https://api.inspirapos.biz.id

# Nomor WA admin untuk aktivasi lisensi (format 62xxx, tanpa +).
# Kosongkan untuk menyembunyikan tombol WhatsApp.
VITE_ADMIN_WA=
